# Copy to .env and fill in.  .env is gitignored — never commit real keys.

# REQUIRED: your Google Gemini API key (kept server-side; clients never see it)
GEMINI_API_KEY=

# OPTIONAL: lock the proxy to your own app. If set, callers must send this exact
# value as their Bearer token; if unset, the proxy is open (zero-config demo mode).
PROXY_ACCESS_KEY=

# OPTIONAL: tuning
PORT=3000
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=3600000
UPSTREAM_TIMEOUT_MS=30000
