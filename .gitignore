# generated data (raw data excluded, synthetic bundled for deployment)
data/raw/*
!data/raw/.gitkeep
# telemetry run logs
telemetry/runs/*
!telemetry/runs/.gitkeep
# python
__pycache__/
*.pyc
*.egg-info/
.venv/
venv*/
.env
.env.*
# vector store / caches
.chroma/
*.faiss
.cache/
# os / editor
.DS_Store
.ipynb_checkpoints/

# claude code harness artifacts
.claude/
.claude

# internal strategy — keep local, do not publish
docs/round2_plan.md
docs/round2_checklist.md

# accenture-provided brief (their IP; the input, not our work) + any stray PDFs
*.pdf

# api keys
api.txt

# ai-assistant scaffolding + runtime logs (keep out of the public repo)
.agents/
*.log

# but always keep env TEMPLATES (no secrets in them)
!**/.env.example
!.env.example
